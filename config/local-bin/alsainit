#!/bin/sh
# Configure the Sound BlasterX G6 as the default speaker and microphone,
# routing capture from the External Mic input at full gain.
#
# Must use a delay like `sh -c 'sleep 5 && $HOME/.local/bin/alsainit'` in
# hyprland.conf or startup services, or the system defaults might overwrite
# alsainit. (WirePlumber restores its saved `analog-input-linein` route after
# login and resets `PCM Capture Source` back to Line In if this script runs
# first.)

# Mux the G6's single ADC to the External Mic input jack.
amixer -c G6 sset 'PCM Capture Source' 'External Mic' > /dev/null
# Enable External Mic capture and set its gain to 100% (+9 dB).
amixer -c G6 sset 'External Mic' Capture 100% cap     > /dev/null

# Resolve the G6's PipeWire sink and source by model name, so the script
# works on any G6 unit regardless of its USB serial.
g6_sink=$(pactl list short sinks   | awk '/^[0-9]+\talsa_output\..*Sound_BlasterX_G6.*analog-stereo/{print $2; exit}')
g6_srce=$(pactl list short sources | awk '/^[0-9]+\talsa_input\..*Sound_BlasterX_G6.*analog-stereo/ {print $2; exit}')

# Promote them to system defaults (no-op if the G6 isn't plugged in).
[ -n "$g6_sink" ] && pactl set-default-sink   "$g6_sink"
[ -n "$g6_srce" ] && pactl set-default-source "$g6_srce"
